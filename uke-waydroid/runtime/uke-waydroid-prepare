#!/usr/bin/sh
# SPDX-License-Identifier: MIT
# Apply the packaged desktop preference to the original Waydroid configuration.
set -eu
export LC_ALL=C
work=${1:-/var/lib/waydroid}
defaults=${2:-/etc/waydroid/uke-defaults.conf}
compatible=${3:-/proc/device-tree/compatible}
[ -f "$work/waydroid.cfg" ] || exit 0
value=$(awk -F= '
    /^[[:space:]]*persist\.waydroid\.multi_windows[[:space:]]*=/ {
        v=$2; gsub(/[[:space:]]/, "", v); count++
    }
    END { if (count != 1 || (v != "true" && v != "false")) exit 1; print v }
' "$defaults")
settings="persist.waydroid.multi_windows=$value"
# Uke's host Mesa uses hint0. Keep the Android driver in agreement while
# retaining UBWC buffers, GLES hardware acceleration and native Turnip.
if [ -r "$compatible" ] && tr '\000' '\n' < "$compatible" | grep -qx 'xiaomi,uke'; then
    settings="$settings
mesa.fd.dev.features=enable_tp_ubwc_flag_hint=0
ro.hardware.vulkan=freedreno"
    # ARM64-only images ship the software Codec2 service, without an OMX HAL.
    # Keep this paired with the packaged pre-mount manifest correction.
    if awk -F= '
        /^\[waydroid\]/ {section=1; next}
        /^\[/ {section=0}
        section {key=$1; value=$2; gsub(/[[:space:]]/, "", key); gsub(/[[:space:]]/, "", value);
                 if (key=="arch") arch=value; if (key=="vendor_type") vendor=value}
        END {exit !(arch=="arm64_only" && vendor=="MAINLINE")}
    ' "$work/waydroid.cfg"; then
        settings="$settings
debug.stagefright.ccodec=1"
    fi
fi
temporary=
trap '[ -z "$temporary" ] || rm -f -- "$temporary"' EXIT HUP INT TERM
for name in waydroid.cfg waydroid_base.prop; do
    file=$work/$name
    [ -e "$file" ] || continue
    [ -f "$file" ] && [ ! -L "$file" ] || exit 1
    temporary=$(mktemp "$work/.uke-waydroid.XXXXXX")
    cp --preserve=all -- "$file" "$temporary"
    awk -v settings="$settings" -v ini="$name" '
        BEGIN {
            count=split(settings, lines, "\n")
            for (i=1; i<=count; i++) {
                eq=index(lines[i], "=")
                keys[i]=substr(lines[i], 1, eq-1)
                values[keys[i]]=substr(lines[i], eq+1)
            }
            if (ini != "waydroid.cfg") section=1
        }
        function emit(   j,k) {
            for (j=1; j<=count; j++) {
                k=keys[j]
                if (!(k in written)) {
                    print k (ini == "waydroid.cfg" ? " = " : "=") values[k]
                    written[k]=1
                }
            }
        }
        ini == "waydroid.cfg" && /^[[:space:]]*\[/ {
            if (section) emit()
            section=($0 ~ /^[[:space:]]*\[properties\][[:space:]]*$/)
            if (section) found=1
        }
        section && index($0, "=") {
            key=substr($0, 1, index($0, "=")-1)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
            if (key in values) next
        }
        {print}
        END {
            if (ini == "waydroid.cfg" && !found) print "\n[properties]"
            emit()
        }
    ' "$file" > "$temporary"
    if ! cmp -s -- "$file" "$temporary"; then
        mv -fT -- "$temporary" "$file"
    else
        rm -f -- "$temporary"
    fi
    temporary=
done
