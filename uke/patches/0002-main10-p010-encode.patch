+    Impl(unsigned w, unsigned h, VAProfile p, const EncodeSettings &s, unsigned cabac)
+        : width(w), height(h), settings(s), profile(p),
+          fourcc(is_10bit(p) ? VA_FOURCC_P010 : VA_FOURCC_NV12), entropy(cabac) {}
     ~Impl() {
         stop(VA_STATUS_ERROR_INVALID_CONTEXT);
