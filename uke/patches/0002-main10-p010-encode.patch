+          "encoder raw buffer is smaller than its visible planes",
+          VA_STATUS_ERROR_ENCODING_ERROR);
     v4l2_selection crop{};
     crop.type = V4L2_BUF_TYPE_VIDEO_OUTPUT;
     crop.target = V4L2_SEL_TGT_CROP;
@@ -615,7 +630,9 @@ Encoder::Encoder(const std::string &device, unsigned width, unsigned height, VAP
     crop.r.height = height;
     checked(e.fd, VIDIOC_S_SELECTION, &crop, "encoder S_SELECTION");
     if (s.hevc) {
-        e.control(V4L2_CID_MPEG_VIDEO_HEVC_PROFILE, V4L2_MPEG_VIDEO_HEVC_PROFILE_MAIN);
