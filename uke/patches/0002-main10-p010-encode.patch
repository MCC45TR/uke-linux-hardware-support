From: MCC45TR <75160848+MCC45TR@users.noreply.github.com>
Subject: [PATCH] Select P010 for HEVC Main10 encode contexts

Keep decoder Main10 render-format compatibility. Require matching profile,
sample depth, kernel raw layout and runtime profile-menu availability.
Native firmware, bitstream precision and GPU/import acceptance remain separate.

---
diff --git a/src/backend.cpp b/src/backend.cpp
index 80e6739..67b4707 100644
--- a/src/backend.cpp
+++ b/src/backend.cpp
@@ -101,11 +101,10 @@ static bool encode_supported(const Driver &d, VAProfile p, VAEntrypoint e) {
            d.encoder_profiles.end();
 }
 static unsigned encode_attribute(VAConfigAttribType type, VAProfile profile) {
-    (void)profile; // HEVC attributes are only available in libva >= 1.13.
     switch (type) {
 #if VA_CHECK_VERSION(1, 13, 0)
     case VAConfigAttribEncHEVCFeatures: {
-        if (profile != VAProfileHEVCMain)
+        if (!is_hevc(profile))
             return VA_ATTRIB_NOT_SUPPORTED;
         // Iris generates the parameter sets and chooses coding tools itself.
         VAConfigAttribValEncHEVCFeatures features{};
@@ -116,7 +115,7 @@ static unsigned encode_attribute(VAConfigAttribType type, VAProfile profile) {
         return features.value;
     }
     case VAConfigAttribEncHEVCBlockSizes: {
-        if (profile != VAProfileHEVCMain)
+        if (!is_hevc(profile))
             return VA_ATTRIB_NOT_SUPPORTED;
         VAConfigAttribValEncHEVCBlockSizes sizes{};
         sizes.bits.log2_max_coding_tree_block_size_minus3 = 2;
@@ -126,7 +125,7 @@ static unsigned encode_attribute(VAConfigAttribType type, VAProfile profile) {
     }
 #endif
     case VAConfigAttribRTFormat:
-        return VA_RT_FORMAT_YUV420;
+        return is_10bit(profile) ? VA_RT_FORMAT_YUV420_10 : VA_RT_FORMAT_YUV420;
     case VAConfigAttribRateControl:
         return VA_RC_CQP | VA_RC_CBR | VA_RC_VBR;
     case VAConfigAttribEncPackedHeaders:
@@ -151,7 +150,9 @@ static unsigned encode_attribute(VAConfigAttribType type, VAProfile profile) {
         return VA_ATTRIB_NOT_SUPPORTED;
     }
 }
-static unsigned profile_format(VAProfile p) {
+static unsigned profile_format(VAProfile p, VAEntrypoint entry) {
+    if (entry == VAEntrypointEncSlice)
+        return encode_attribute(VAConfigAttribRTFormat, p);
     bool is_vp9_2 = p == VAProfileVP9Profile2;
     // Chromium requires Main10 to be compatible with 8-bit format.
     // This also applies to future 10-bit profiles other than VP9_2.
@@ -293,7 +294,7 @@ API(
         }
         switch (attrs[i].type) {
         case VAConfigAttribRTFormat:
-            attrs[i].value = profile_format(profile);
+            attrs[i].value = profile_format(profile, entry);
             break;
         case VAConfigAttribDecSliceMode:
             attrs[i].value = VA_DEC_SLICE_MODE_NORMAL;
@@ -324,7 +325,8 @@ API(
                   "unsupported encoder config attribute", VA_STATUS_ERROR_ATTR_NOT_SUPPORTED);
             auto value = encode_attribute(type, p);
             check(!(attrs[i].value & ~value) &&
-                      (type != VAConfigAttribRTFormat || attrs[i].value == VA_RT_FORMAT_YUV420),
+                      (type != VAConfigAttribRTFormat ||
+                       attrs[i].value == encode_attribute(VAConfigAttribRTFormat, p)),
                   "unsupported encoder attribute", VA_STATUS_ERROR_ATTR_NOT_SUPPORTED);
             if (attrs[i].type == VAConfigAttribRateControl) {
                 check(attrs[i].value == VA_RC_CQP || attrs[i].value == VA_RC_CBR ||
@@ -333,7 +335,7 @@ API(
                 config.rate_control = attrs[i].value;
             }
         } else if (attrs[i].type == VAConfigAttribRTFormat)
-            check(attrs[i].value && !(attrs[i].value & ~profile_format(p)),
+            check(attrs[i].value && !(attrs[i].value & ~profile_format(p, e)),
                   "unsupported render format", VA_STATUS_ERROR_UNSUPPORTED_RT_FORMAT);
         else if (e == VAEntrypointVLD && attrs[i].type == VAConfigAttribDecSliceMode)
             check(attrs[i].value == VA_DEC_SLICE_MODE_NORMAL, "unsupported slice mode",
@@ -349,7 +351,7 @@ API(query_config,
     (VADriverContextP ctx, VAConfigID id, VAProfile *p, VAEntrypoint *e, VAConfigAttrib *a, int *n),
     auto config = lookup(d.configs, id, VA_STATUS_ERROR_INVALID_CONFIG);
     *p = config.profile; *e = config.entrypoint;
-    a[0] = {VAConfigAttribRTFormat, profile_format(*p)}; *n = 1;
+    a[0] = {VAConfigAttribRTFormat, profile_format(*p, *e)}; *n = 1;
     if (*e == VAEntrypointEncSlice) a[(*n)++] = {VAConfigAttribRateControl, config.rate_control};
     return VA_STATUS_SUCCESS;)
 API(
@@ -378,7 +380,8 @@ API(
         a[i].value.type = VAGenericValueTypeInteger;
         a[i].value.value.i = values[i];
     } unsigned n = 6;
-    if (values[0] != VA_FOURCC_NV12 && (profile_format(profile) & VA_RT_FORMAT_YUV420)) {
+    if (values[0] != VA_FOURCC_NV12 &&
+        (profile_format(profile, config.entrypoint) & VA_RT_FORMAT_YUV420)) {
         a[n] = a[0];
         a[n++].value.value.i = VA_FOURCC_NV12;
     } if (!attrs) {
