@@ -574,9 +582,9 @@ Encoder::Encoder(const std::string &device, unsigned width, unsigned height, VAP
     check(width >= 128 && height >= 128 && width <= 3840 && height <= 2160 && !(width & 1) &&
               !(height & 1),
           "unsupported visible encoder dimensions", VA_STATUS_ERROR_RESOLUTION_NOT_SUPPORTED);
-    validate(s, p, width, height);
+    validate(s, p, profile, width, height);
     auto impl = std::make_unique<Impl>(
-        width, height, s, s.hevc ? 1 : p.params.pic_fields.bits.entropy_coding_mode_flag);
+        width, height, profile, s, s.hevc ? 1 : p.params.pic_fields.bits.entropy_coding_mode_flag);
     auto &e = *impl;
     e.filter = deblocking(p, s.hevc);
     e.render_fd = fcntl(render_fd, F_DUPFD_CLOEXEC, 0);
@@ -600,14 +608,21 @@ Encoder::Encoder(const std::string &device, unsigned width, unsigned height, VAP
     fmt.type = OUTPUT;
     fmt.fmt.pix_mp.width = width;
     fmt.fmt.pix_mp.height = height;
-    fmt.fmt.pix_mp.pixelformat = V4L2_PIX_FMT_NV12;
+    const unsigned raw_format = e.fourcc == VA_FOURCC_P010 ? V4L2_PIX_FMT_P010 : V4L2_PIX_FMT_NV12;
+    fmt.fmt.pix_mp.pixelformat = raw_format;
     fmt.fmt.pix_mp.field = V4L2_FIELD_NONE;
-    checked(e.fd, VIDIOC_S_FMT, &fmt, "encoder S_FMT NV12");
