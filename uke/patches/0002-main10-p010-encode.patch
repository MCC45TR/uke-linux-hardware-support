                 m->stride = e.stride;
diff --git a/src/runtime-caps.cpp b/src/runtime-caps.cpp
index d547d34..0948660 100644
--- a/src/runtime-caps.cpp
+++ b/src/runtime-caps.cpp
@@ -56,10 +56,10 @@ std::vector<VAProfile> probe_profiles(const std::string &path, bool encoder) {
