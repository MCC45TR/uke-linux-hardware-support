--- /dev/null
+++ b/src/runtime-caps.cpp
@@ -0,0 +1,90 @@
+// SPDX-License-Identifier: MIT
+#include "internal.hpp"
+#include <linux/videodev2.h>
+#include <sys/ioctl.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <cerrno>
+
+namespace irisva {
+namespace {
+int query(int fd, unsigned long request, void *arg) {
+    int result;
+    do { result = ioctl(fd, request, arg); } while (result < 0 && errno == EINTR);
+    return result;
+}
+bool format_available(int fd, unsigned type, unsigned fourcc) {
+    v4l2_fmtdesc fmt{};
+    fmt.type = type;
+    while (!query(fd, VIDIOC_ENUM_FMT, &fmt)) {
+        if (fmt.pixelformat == fourcc) return true;
+        ++fmt.index;
+    }
+    return false;
+}
+struct Profile {
+    VAProfile va;
+    unsigned codec, control, menu, raw;
+};
+constexpr Profile profiles[] = {
+    {VAProfileH264ConstrainedBaseline, V4L2_PIX_FMT_H264,
+     V4L2_CID_MPEG_VIDEO_H264_PROFILE, V4L2_MPEG_VIDEO_H264_PROFILE_CONSTRAINED_BASELINE,
+     V4L2_PIX_FMT_NV12},
+    {VAProfileH264Main, V4L2_PIX_FMT_H264, V4L2_CID_MPEG_VIDEO_H264_PROFILE,
+     V4L2_MPEG_VIDEO_H264_PROFILE_MAIN, V4L2_PIX_FMT_NV12},
+    {VAProfileH264High, V4L2_PIX_FMT_H264, V4L2_CID_MPEG_VIDEO_H264_PROFILE,
+     V4L2_MPEG_VIDEO_H264_PROFILE_HIGH, V4L2_PIX_FMT_NV12},
+    {VAProfileHEVCMain, V4L2_PIX_FMT_HEVC, V4L2_CID_MPEG_VIDEO_HEVC_PROFILE,
+     V4L2_MPEG_VIDEO_HEVC_PROFILE_MAIN, V4L2_PIX_FMT_NV12},
+    {VAProfileHEVCMain10, V4L2_PIX_FMT_HEVC, V4L2_CID_MPEG_VIDEO_HEVC_PROFILE,
+     V4L2_MPEG_VIDEO_HEVC_PROFILE_MAIN_10, V4L2_PIX_FMT_P010},
+    {VAProfileVP9Profile0, V4L2_PIX_FMT_VP9, V4L2_CID_MPEG_VIDEO_VP9_PROFILE,
+     V4L2_MPEG_VIDEO_VP9_PROFILE_0, V4L2_PIX_FMT_NV12},
+    {VAProfileVP9Profile2, V4L2_PIX_FMT_VP9, V4L2_CID_MPEG_VIDEO_VP9_PROFILE,
+     V4L2_MPEG_VIDEO_VP9_PROFILE_2, V4L2_PIX_FMT_P010},
+};
+}
+
+std::vector<VAProfile> probe_profiles(const std::string &path, bool encoder) {
+    std::vector<VAProfile> result;
+    if (path.empty()) return result;
+    int fd = open(path.c_str(), O_RDWR | O_NONBLOCK | O_CLOEXEC);
+    check(fd >= 0, "open Iris capability probe");
+    try {
+        const unsigned coded = encoder ? V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE
+                                       : V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+        const unsigned raw = encoder ? V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE
+                                     : V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+        for (const auto &profile : profiles) {
+            // The backend encoder implements only H264 and HEVC Main NV12.
+            if (encoder && profile.va != VAProfileH264ConstrainedBaseline &&
+                profile.va != VAProfileH264Main && profile.va != VAProfileH264High &&
+                profile.va != VAProfileHEVCMain) continue;
+            if (!format_available(fd, coded, profile.codec)) continue;
+            v4l2_format fmt{};
+            fmt.type = coded;
+            fmt.fmt.pix_mp.width = fmt.fmt.pix_mp.height = 128;
+            fmt.fmt.pix_mp.pixelformat = profile.codec;
+            fmt.fmt.pix_mp.num_planes = 1;
+            if (query(fd, VIDIOC_S_FMT, &fmt) < 0 ||
+                fmt.fmt.pix_mp.pixelformat != profile.codec) continue;
+            v4l2_queryctrl control{};
+            control.id = profile.control;
+            if (query(fd, VIDIOC_QUERYCTRL, &control) < 0 ||
+                control.flags & V4L2_CTRL_FLAG_DISABLED ||
+                control.type != V4L2_CTRL_TYPE_MENU) continue;
+            v4l2_querymenu menu{};
+            menu.id = profile.control;
+            menu.index = profile.menu;
+            if (query(fd, VIDIOC_QUERYMENU, &menu) < 0 ||
+                !format_available(fd, raw, profile.raw)) continue;
+            result.push_back(profile.va);
+        }
+    } catch (...) {
+        close(fd);
+        throw;
+    }
+    close(fd);
+    return result;
+}
+}
