Subject: [PATCH] Own SSC report subscriptions and tasks per asynchronous request

Upstream: libssc 0.4.4, GPL-3.0-or-later, Dylan Van Assche.

Keep each report listener and send acknowledgement alive independently.

Complete only once and disconnect the exact request before task cleanup.

--- a/src/libssc-sensor.c
+++ b/src/libssc-sensor.c
@@ -43,6 +43,8 @@
 typedef struct {
 	GTask *task;
 	SSCSensor *sensor;
+	SSCClient *client;
+	gulong report_id;
 } ReportReceivedContext;
 
 typedef struct _SSCSensorPrivate {
@@ -57,7 +59,6 @@
 	gfloat mount_matrix[3][3];
 
 	SSCClient *client;
-	guint report_id;
 	gboolean attr_populated;
 	gboolean service_available;
 	guint service_retries;
@@ -65,11 +66,60 @@
 
 static void async_initable_iface_init (GAsyncInitableIface *iface);
 
+static void
+report_received (SSCClient *self, guint32 msg_id, guint64 uid_high, guint64 uid_low, GArray *buf, gpointer user_data);
+
 G_DEFINE_TYPE_WITH_CODE (SSCSensor, ssc_sensor, G_TYPE_OBJECT,
 			 G_ADD_PRIVATE (SSCSensor)
 			 G_IMPLEMENT_INTERFACE (G_TYPE_ASYNC_INITABLE, async_initable_iface_init))
 
 static void
+report_context_free (gpointer data)
+{
+	ReportReceivedContext *ctx = data;
+	g_clear_object (&ctx->client);
+	g_slice_free (ReportReceivedContext, ctx);
+}
+
+static void
+report_closure_free (gpointer data, GClosure *closure)
+{
+	g_object_unref (data);
+}
+
+static void
+report_context_watch (SSCSensor *sensor, SSCClient *client, GTask *task)
+{
+	ReportReceivedContext *ctx = g_slice_new0 (ReportReceivedContext);
+	ctx->task = task; /* Borrowed from the task which owns this context. */
+	ctx->sensor = sensor; /* The task owns its source object. */
+	ctx->client = g_object_ref (client);
+	g_task_set_task_data (task, ctx, report_context_free);
+	ctx->report_id = g_signal_connect_data (client, "report",
+			G_CALLBACK (report_received), g_object_ref (task),
+			report_closure_free, 0);
+}
+
+static void
+report_complete (GTask *task, gboolean success, GError *error)
+{
+	ReportReceivedContext *ctx = g_task_get_task_data (task);
+	gulong report_id = ctx->report_id;
+
+	/* A report and its send acknowledgement may complete in either order. */
+	if (!report_id) {
+		g_clear_error (&error);
+		return;
+	}
+	ctx->report_id = 0;
+	g_signal_handler_disconnect (ctx->client, report_id);
+	if (error)
+		g_task_return_error (task, error);
+	else
+		g_task_return_boolean (task, success);
+}
+
+static void
 wait_for_sensor_service (SSCSensor *self, GTask *task);
 
 static void
@@ -78,9 +128,6 @@
