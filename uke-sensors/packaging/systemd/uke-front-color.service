[Unit]
Description=Uke raw front-color snapshot publisher
ConditionFirmware=device-tree-compatible(xiaomi,uke)
Requires=uke-ssc-sensors.service
BindsTo=uke-ssc-sensors.service
After=uke-ssc-sensors.service
PartOf=uke-ssc-sensors.service

[Service]
Type=simple
ExecStart=/usr/libexec/uke-front-color
User=root
Group=root
RuntimeDirectory=senemos-uke/sensors
RuntimeDirectoryMode=0755
UMask=0022
TimeoutStopSec=10
Restart=no
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/senemos-uke/sensors
DevicePolicy=closed
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_QIPCRTR
MemoryDenyWriteExecute=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=uke-ssc-sensors.service
