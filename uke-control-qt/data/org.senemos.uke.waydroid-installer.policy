<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>Uke</vendor>
  <action id="org.senemos.uke.waydroid-install">
    <description>Install Waydroid</description>
    <description xml:lang="tr">Waydroid’i kur</description>
    <message>Authentication is required to install Waydroid and its Android image.</message>
    <message xml:lang="tr">Waydroid ve Android imajını kurmak için yönetici yetkisi gerekiyor.</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/uke-control-qt/waydroid-installer</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">start</annotate>
  </action>
  <action id="org.senemos.uke.waydroid-google-registration">
    <description>Read the Waydroid Google registration identifier</description>
    <description xml:lang="tr">Waydroid Google kayıt kimliğini oku</description>
    <message>Authentication is required to read the Android Google registration identifier.</message>
    <message xml:lang="tr">Android Google kayıt kimliğini okumak için yönetici yetkisi gerekiyor.</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/uke-control-qt/waydroid-installer</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">google-id</annotate>
  </action>
</policyconfig>
