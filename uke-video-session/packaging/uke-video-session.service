[Unit]
Description=Uke per-user video workload policy
Documentation=https://github.com/MCC45TR/uke-linux-hardware-support

[Service]
Type=dbus
BusName=org.uke.VideoSession1
ExecStart=/usr/libexec/uke-video-session
ExecStopPost=/usr/libexec/uke-video-session --restore
RuntimeDirectory=uke-video-session
RuntimeDirectoryMode=0700
Restart=on-failure
RestartSec=1s
TimeoutStopSec=5s
NoNewPrivileges=yes
UMask=0077
