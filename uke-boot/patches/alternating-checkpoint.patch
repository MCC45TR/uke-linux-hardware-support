+    saved.candidate_image.clear();saved.staged_boot_id.clear();(void)encode(saved);return saved;
+}
+static void preserve_accepted_kernel(const fs::path &state,const UserdataUpdate &saved,const Bytes &image) {
+    if(!saved.baseline_approved)return;
+    need(saved.good_image==digest(image),"Accepted recovery source differs from its protected record");
+    const auto kernel=boot_kernel(image);
+    need(fs::space(state).available>kernel.size()+32*1024*1024,"Insufficient accepted-kernel recovery artifact space");
+    const auto banner="Linux version "+saved.policy.good_release+" ";
+    need(std::search(kernel.begin(),kernel.end(),banner.begin(),banner.end())!=kernel.end(),"Accepted recovery kernel release differs from its record");
+    const auto recovery=state/"accepted-kernel-recovery"/saved.policy.good_release;
+    auto dir=directory(recovery,true);
+    // Retain only the required kernel component and its small wrapper/record.
+    // No root-filesystem image or full boot-partition backup is created.
+    const auto retain=[&](const char *name,const Bytes &bytes) {
+        const auto path=recovery/name;
+        if(fs::exists(path))need(file(path)==bytes,"Existing accepted-kernel recovery artifact differs");
+        else save_new(path,bytes);
+    };
+    retain("Image",kernel);
+    retain("boot-header",Bytes(image.begin(),image.begin()+4096));
+    const auto record=encode(saved);retain("approval.state",Bytes(record.begin(),record.end()));
+}
