+    const bool returned=saved.policy.phase==uke_install::Phase::trial && running==unsigned(saved.policy.good) &&
+                        valid_boot_id(boot_id) && saved.staged_boot_id!=boot_id;
+    if(!incomplete && !returned)return {};
+    need(running==unsigned(saved.policy.good) && release==saved.policy.good_release && image_hash==saved.good_image,
+         "Interrupted stage requires the unchanged running baseline");
