Subject: [PATCH] Retain unapproved checkpoints at the actual pre-write barrier

--- a/src/slot-control.hpp
+++ b/src/slot-control.hpp
@@ -147,18 +147,29 @@
                  "GPT and UFS boot LUN selection differ");
         }
     }
-    bool block_inactive(unsigned running,unsigned target) {
+    bool block_inactive(unsigned running,unsigned target,bool retain_checkpoint=false) {
         need(running<2 && target==1-running,"Inactive slot required before writing");
         require_selected(running);
         const auto good=std::string("boot_")+(running?'b':'a');
         const auto next=std::string("boot_")+(target?'b':'a');
         if(!parts.contains(good) && !parts.contains(next))return false;
         need(parts.contains(good) && parts.contains(next),"Unpaired boot slot");
-        need((parts.at(good).attrs&successful) && !(parts.at(good).attrs&unbootable),
-             "Accepted boot must be successful before writing the inactive slot");
+        const auto &held=parts.at(good);
+        need(((held.attrs&successful) || (retain_checkpoint && (held.attrs&priority))) && !(held.attrs&unbootable),
+             "Running boot must be retained before writing the inactive slot");
+        bool changed=false;
+        // The caller has proven an unapproved booted checkpoint in off mode.
+        // Retain its bootloader fallback before any candidate bytes are touched;
+        // the protected format2 record remains explicitly health-unapproved.
+        if(retain_checkpoint && !(held.attrs&successful)) {
+            const auto retained=held.attrs|successful;
+            need(!fdisk_gpt_set_partition_attrs(context.get(),held.number,retained) && !warning,
+                 "Cannot retain the running checkpoint before inactive write");
+            expected[good]={held.type,retained};changed=true;
+        }
         const auto &p=parts.at(next);
         const auto attrs=(p.attrs&~(successful|retries|priority))|unbootable;
-        if(attrs==p.attrs)return false;
+        if(attrs==p.attrs)return changed;
         need(!fdisk_gpt_set_partition_attrs(context.get(),p.number,attrs) && !warning,
              "Cannot mark the inactive boot slot unbootable");
         expected[next]={p.type,attrs};
