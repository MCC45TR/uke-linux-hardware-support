+static uke_counter_clock::Sample counter_clock_sample() {
+    const auto value=clock_sample();timespec boot{};
+    require(clock_gettime(CLOCK_BOOTTIME,&boot)==0 && boot.tv_sec>=0 && boot.tv_nsec>=0 &&
+            boot.tv_nsec<1000000000 && uint64_t(boot.tv_sec)<=UINT64_MAX/1000000000,
+            "Cannot read the startup clock for counter qualification");
+    return {value.now.tv_sec,uint64_t(boot.tv_sec)*1000000000+uint64_t(boot.tv_nsec),value.synchronized};
+}
+static bool save_counter_clock(int state_fd) {
+    if(!uke_counter_clock::Counter::available())return false;
+    try {
+        uke_counter_clock::Counter counter;
+        const auto result=uke_counter_clock::synchronize([&]{return counter.read();},counter_clock_sample,
+            [&]{return uke_counter_clock::read_for_sync(state_fd);},
+            [&](const auto &record){uke_counter_clock::write_record(state_fd,record);},[]{usleep(250000);});
+        if(result==uke_counter_clock::Result::saved) {
+            std::cout<<"Persisted and verified the synchronized PMIC counter anchor; hardware counter and OEM persist unchanged.\n";
+            return true;
+        }
+    } catch(const std::exception &error) {
+        std::cerr<<"Counter clock anchor deferred: "<<error.what()<<"; existing clock-floor path retained.\n";
+    }
+    return false;
+}
+static bool restore_counter_clock(int state_fd) {
+    if(!uke_counter_clock::Counter::available())return false;
+    try {
+        const auto record=uke_counter_clock::read_record(state_fd);
+        if(!record)return false;
+        uke_counter_clock::Counter counter;
+        const auto result=uke_counter_clock::restore(*record,[&]{return counter.read();},counter_clock_sample,
+            [](int64_t utc){const timespec value{utc,0};return clock_settime(CLOCK_REALTIME,&value);},[]{usleep(250000);});
+        if(result==uke_counter_clock::Result::restored) {
+            std::cout<<"Restored startup UTC from the advancing read-only PMIC counter and private synchronized anchor.\n";
+            return true;
+        }
+    } catch(const std::exception &error) {
+        std::cerr<<"Counter clock restore deferred: "<<error.what()<<"; existing clock-floor path retained.\n";
+    }
+    return false;
+}
+static void check_counter_clock(int state_fd) {
