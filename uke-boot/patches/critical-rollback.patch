+static std::string critical_rejection_text(const std::string &release) {
+    const fs::path state="/var/lib/senemos/kernel-update";
+    auto boot=read_text("/proc/sys/kernel/random/boot_id");
+    need(boot.ends_with('\n'),"Missing critical-health boot identity");boot.pop_back();
+    const auto hash=digest(file(state/"userdata.state"));
+    const auto text="format=1\nkernel="+release+"\nboot="+boot+"\nstate_sha256="+hash+"\ncritical=adsp-crashed\n";
+    need(critical_rejection_matches(text,release,boot,hash),"Invalid critical-health identity");return text;
+}
+static bool active_critical_rejection() {
+    const fs::path marker="/var/lib/senemos/kernel-update/critical-health";
+    if(!policy_exists(marker))return false;
+    utsname running{};need(!uname(&running),"Missing critical-health running kernel");
+    return policy_text(marker)==critical_rejection_text(running.release);
+}
+static bool fallback_policy_allowed() {
+    return critical_fallback_policy(rollback_name(read_rollback_policy()),active_critical_rejection());
