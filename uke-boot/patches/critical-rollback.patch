+// Validate the retained identity before restoring a late failed trial. Bundle,
+// firmware and physical metadata validation remain in the caller.
+static bool critical_retained_pair_matches(const UserdataUpdate &retained,
+        const std::string &recorded_boot,const std::string &current_boot,
+        unsigned running,const std::string &release,const std::string &current_hash,
+        const std::string &other_hash) {
+    return valid_boot_id(current_boot) && recorded_boot==current_boot+"\n" &&
+        running<2 && unsigned(retained.policy.good)<2 &&
+        retained.policy.phase==uke_install::Phase::trial &&
+        retained.policy.candidate==release && retained.candidate_image==current_hash &&
+        unsigned(retained.policy.good)!=running && retained.good_image==other_hash;
+}
+static bool fallback_metadata_power(bool critical,const fs::path &root="/") {
+    try {if(charging(root/"sys/class/power_supply"))return true;}catch(const std::exception &){}
+    // Only the small return-to-verified-slot metadata transaction may use the
+    // independent USB-C power indication when the crashed DSP loses battery
+    // telemetry. Image staging retains the original measured-battery gate.
+    if(!critical)return false;
+    const fs::path source=root/"sys/class/power_supply/ucsi-source-psy-pmic_glink.ucsi.01";
+    return critical_health_value(source/"type")=="USB" && critical_health_value(source/"online")=="1";
+}
