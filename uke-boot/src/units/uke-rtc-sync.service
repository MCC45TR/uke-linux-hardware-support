[Unit]
Description=Synchronize the admitted Uke secure RTC and verify its UTC calendar
ConditionFirmware=device-tree-compatible(xiaomi,uke)
ConditionPathExists=/sys/firmware/devicetree/base/soc/qcom,spmi@c42d000/qcom,pmk8550@0/rtc@6100/qcom,uefi-rtc-info
After=chronyd.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/senemos-uke/uke-install-profile rtc-sync
TimeoutStartSec=8
UMask=0077
CapabilityBoundingSet=CAP_SYS_TIME
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=char-rtc rw
