[Unit]
Description=Bound startup of an unaccepted Uke A/B kernel
DefaultDependencies=no
ConditionFirmware=device-tree-compatible(xiaomi,uke)
ConditionKernelCommandLine=root=PARTLABEL=userdata
IgnoreOnIsolate=yes
Conflicts=shutdown.target
Before=shutdown.target
OnFailure=uke-userdata-deadline-fallback.service

[Service]
Type=exec
ExecCondition=/usr/bin/uke-kernel-update guard-required
ExecStart=/usr/bin/uke-kernel-update guard
TimeoutStartSec=infinity
RuntimeMaxSec=300
TimeoutStopSec=3
UMask=0077
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=sysinit.target
