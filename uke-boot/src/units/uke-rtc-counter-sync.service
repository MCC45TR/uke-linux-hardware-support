[Unit]
Description=Save the Uke read-only PMIC counter anchor from synchronized UTC
ConditionFirmware=device-tree-compatible(xiaomi,uke)
ConditionPathExists=/sys/firmware/devicetree/base/soc/qcom,spmi@c42d000/qcom,pmk8550@0/rtc@6100
ConditionPathExists=!/sys/firmware/devicetree/base/soc/qcom,spmi@c42d000/qcom,pmk8550@0/rtc@6100/qcom,uefi-rtc-info
After=chronyd.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/senemos-uke/uke-install-profile clock-save
TimeoutStartSec=8
UMask=0077
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/senemos/installation
DevicePolicy=closed
RestrictAddressFamilies=AF_UNIX
