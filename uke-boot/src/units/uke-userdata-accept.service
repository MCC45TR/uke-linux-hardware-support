[Unit]
Description=Accept a healthy Uke userdata slot and stage installed updates
ConditionFirmware=device-tree-compatible(xiaomi,uke)
ConditionKernelCommandLine=root=PARTLABEL=userdata
After=chronyd.service time-set.target display-manager.service uke-install-profile.service uke-touchscreen.service uke-adaptive-display.target
Wants=chronyd.service uke-adaptive-display.target
OnFailure=uke-userdata-fallback.service
StartLimitIntervalSec=infinity
StartLimitBurst=5

[Service]
Type=oneshot
ExecStart=/usr/bin/uke-kernel-update boot
TimeoutStartSec=120
Restart=on-failure
RestartPreventExitStatus=78
RestartMode=direct
RestartSec=30
UMask=0077
ProtectHome=yes
PrivateTmp=yes
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=graphical.target
