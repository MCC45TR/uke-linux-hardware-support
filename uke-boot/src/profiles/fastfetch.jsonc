{
  "logo": { "type": "builtin", "source": "fedora" },
  "modules": [
    "title", "separator", "os",
    { "type": "host", "format": "Xiaomi Pad 7 (1.1) [uke]" },
    "kernel", "uptime", "packages", "shell",
    { "type": "display", "format": "{width}x{height}{?refresh-rate} @ {refresh-rate} Hz{?} [{type}]{?bit-depth}, {bit-depth} bpc{?}{?hdr-enabled}, HDR{?}{?is-primary} *{?}" },
    { "type": "custom", "key": "Panel (specification)", "format": "11.2-inch (advertised)" },
    "terminal",
    { "type": "cpu", "format": "Qualcomm Snapdragon 7+ Gen 3 (SM7675) ({cores-online} cores) @ {freq-max}" },
    "gpu",
    "memory", "swap", { "type": "disk", "folders": "/" },
    "break", "colors"
  ]
}
