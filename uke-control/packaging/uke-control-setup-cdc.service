[Unit]
Description=Temporary Uke USB access during Plasma setup
Requires=sys-kernel-config.mount
After=sys-kernel-config.mount systemd-udev-trigger.service uke-control.service
Before=plasma-setup.service
ConditionFirmware=device-tree-compatible(xiaomi,uke)
ConditionPathExists=/etc/uke-control/first-setup-cdc
ConditionPathExists=!/etc/plasma-setup-done
StartLimitIntervalSec=30
StartLimitBurst=3

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/uke-control setup-cdc apply --json
ExecStartPost=/usr/bin/systemctl --no-block start uke-control-setup-console.service
TimeoutStartSec=45
Restart=on-failure
RestartSec=1
StateDirectory=uke-control
StateDirectoryMode=0700
RuntimeDirectory=senemos-uke uke-control-setup
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ProtectHome=yes
PrivateTmp=yes
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
