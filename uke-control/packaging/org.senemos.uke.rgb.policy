<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>Senemos</vendor>
  <action id="org.senemos.uke.rgb.control">
    <description>Control the Uke notification LED</description>
    <message>Only an active local user can control the notification LED.</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>yes</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.owner">unix-user:uke-rgb</annotate>
  </action>
</policyconfig>
