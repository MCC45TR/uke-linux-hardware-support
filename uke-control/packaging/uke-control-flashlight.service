[Unit]
Description=Uke Control torch request broker
After=dbus.service
Before=sleep.target
Conflicts=sleep.target
ConditionPathExists=/sys/class/leds/uke:white:torch/brightness

[Service]
Type=dbus
BusName=org.senemos.Uke.Torch
User=uke-rgb
Group=uke-rgb
RuntimeDirectory=uke-control-torch
RuntimeDirectoryMode=0700
ExecStart=/usr/libexec/uke-control/rgb-led --torch
ExecStopPost=/usr/libexec/uke-control/rgb-led --torch-off
TimeoutStartSec=5
TimeoutStopSec=3
Restart=no
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ReadWritePaths=/sys/class/leds/uke:white:torch/brightness
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
DevicePolicy=closed
UMask=0077
