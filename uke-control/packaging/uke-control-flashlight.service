[Unit]
Description=Uke torch brightness control
Before=sleep.target
Conflicts=sleep.target

[Service]
Type=notify
ExecStart=/usr/bin/uke-control flashlight hold
ExecStopPost=/usr/bin/uke-control flashlight reset
TimeoutStartSec=5
TimeoutStopSec=3
Restart=no
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
