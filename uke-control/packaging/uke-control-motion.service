[Unit]
Description=Uke leased display inclination
After=dbus.service systemd-logind.service

[Service]
Type=dbus
BusName=org.senemos.Uke.Motion1
ExecStart=/usr/libexec/uke-control/motion
ExecStopPost=/usr/libexec/uke-control/motion --recover
Restart=no
WatchdogSec=2s
WatchdogSignal=SIGABRT
TimeoutAbortSec=1s
TimeoutStopSec=2s
LimitCORE=0
RuntimeDirectory=uke-control-motion
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

# Bus activation only: no install target and no persistent idle sensor daemon.
