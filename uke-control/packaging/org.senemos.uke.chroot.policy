<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>Senemos</vendor>
  <action id="org.senemos.uke.chroot.manage">
    <description>Inspect or enter a trusted Fedora or Arch root filesystem</description>
    <message>Administrator authorization is required. Chroot can execute target-controlled root code and shares the host kernel.</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/uke-control/chroot-manager</annotate>
  </action>
</policyconfig>
