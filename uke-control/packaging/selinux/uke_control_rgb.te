policy_module(uke_control_rgb, 1.4)

type uke_rgb_t;
type uke_rgb_exec_t;
init_daemon_domain(uke_rgb_t, uke_rgb_exec_t)
init_nnp_daemon_domain(uke_rgb_t)
selinux_get_enforce_mode(uke_rgb_t)

type uke_rgb_device_t;
dev_node(uke_rgb_device_t)
allow uke_rgb_t uke_rgb_device_t:chr_file { getattr open read write ioctl };
allowxperm uke_rgb_t uke_rgb_device_t:chr_file ioctl { 0xb700 0xb701 0xb702 0xb703 };

# Both brokers transport requests; the kernel owns output and writer lifetime.
type uke_torch_device_t;
dev_node(uke_torch_device_t)
allow uke_rgb_t uke_torch_device_t:chr_file { getattr open read write ioctl };
allowxperm uke_rgb_t uke_torch_device_t:chr_file ioctl { 0x5480 0x5481 0x5482 };
dev_read_sysfs(uke_rgb_t)
auth_read_passwd(uke_rgb_t)
libs_use_ld_so(uke_rgb_t)
libs_use_shared_libs(uke_rgb_t)
files_read_etc_files(uke_rgb_t)
miscfiles_read_localization(uke_rgb_t)
init_use_fds(uke_rgb_t)
logging_send_syslog_msg(uke_rgb_t)
dbus_system_bus_client(uke_rgb_t)
allow uke_rgb_t self:dbus acquire_svc;
gen_require(`attribute userdomain; class dbus { acquire_svc send_msg };')
allow uke_rgb_t userdomain:dbus send_msg;
allow userdomain uke_rgb_t:dbus send_msg;
policykit_dbus_chat(uke_rgb_t)
