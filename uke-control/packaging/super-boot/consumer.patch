+[[maybe_unused]] static Bytes derive_slot_image(Bytes bytes,unsigned target) {
+    const auto kernel=boot_kernel(bytes);
+    auto profile=uke_boot_profile::parse(std::string(reinterpret_cast<const char*>(bytes.data()+44)));
+    need(profile.userdata,"Slot annotation requires a userdata boot profile");
+    profile.slot=target;
+    uke_boot_profile::set(bytes,profile,kernel);
+    need(boot_kernel(bytes)==kernel,"Slot annotation changed the package Image");
+    return bytes;
+}
