+    if (std::getenv("UKE_AUDIO_TEST_READ_FAILURE")) return -EIO;
+    const auto *state = locked ? std::getenv("UKE_AUDIO_TEST_LOCKED_STATE") : nullptr;
+    if (!state) state = std::getenv("UKE_AUDIO_TEST_STATE");
     snd_ctl_elem_value_set_enumerated(value, 0, state ? std::strtoul(state, nullptr, 10) : 0);
     return 0;
 }
