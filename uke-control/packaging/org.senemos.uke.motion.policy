<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Uke Linux</vendor>
  <vendor_url>https://github.com/MCC45TR/uke-linux-hardware-support</vendor_url>
  <action id="org.senemos.uke.motion.observe">
    <description>Observe display inclination</description>
    <message>A local active session is required to observe display inclination.</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>yes</allow_active></defaults>
  </action>
</policyconfig>
