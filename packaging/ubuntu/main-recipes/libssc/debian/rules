#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
%:
	dh $@ --buildsystem=meson --sourcedirectory=upstream
override_dh_auto_configure:
	 bash debian/verify-main-inputs
	 bash debian/prepare-libssc
	dh_auto_configure --sourcedirectory=upstream -- -Dtests=false
override_dh_auto_test:
	# Native tests require approval; Python mock tests are intentionally excluded.
override_dh_auto_install:
	dh_auto_install
	! find debian/tmp -type f \( -name '*.py' -o -name '*python*' \) | grep .
override_dh_makeshlibs:
	dh_makeshlibs -V 'libssc2 (>= 0.4.4-2ubuntu1~uke1~tenacious1)'
override_dh_gencontrol:
	dh_girepository
	dh_gencontrol

override_dh_auto_clean:
	bash debian/verify-main-inputs
	if test -d upstream; then dh_auto_clean --sourcedirectory=upstream; fi
	rm -rf upstream
