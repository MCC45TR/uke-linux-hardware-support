#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
%:
	dh $@
override_dh_auto_configure:
override_dh_auto_build:
	dh_auto_build -- all
override_dh_auto_test:
	# Native execution requires approval; preserve shared source test fixtures.
override_dh_auto_clean:
	rm -rf build
override_dh_auto_install:
	dh_auto_install --destdir=debian/tmp -- prefix=/usr
override_dh_installsystemd:
	dh_installsystemd -puke-battery-observer --no-start
	dh_installsystemd -puke-charge-control --no-enable --no-start
	dh_installsystemd -puke-offline-charge --no-enable --no-start
