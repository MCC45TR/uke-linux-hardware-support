From: Uke Linux contributors <75160848+MCC45TR@users.noreply.github.com>
Subject: [PATCH] libqcomtee: refuse failed QCBOR credential encoding

Against QUIC/quic-teec 736419e25a2036aac3292a10a93e394a90750ca3.
Keep Qualcomm's BSD-3-Clause attribution in the patched source.
QCBOREncode_Finish can fail for reasons other than buffer capacity. In that
case enc is not an output and must not be published as a credential buffer.
Initialize the output and release the allocation on all encoding failures.
The actual encoder is exercised with injected Finish errors in COPR.

--- a/upstream/quic-teec/libqcomtee/src/objects/credentials_obj.c
+++ b/upstream/quic-teec/libqcomtee/src/objects/credentials_obj.c
@@ -54,9 +54,13 @@
 static int credentials_init(struct qcomtee_ubuf *ubuf)
 {
 	QCBOREncodeContext e_ctx;
-	UsefulBufC enc;
+	UsefulBufC enc = { NULL, 0 };
+	QCBORError error;
 	UsefulBuf creds_useful_buf = { NULL, 0 };
 
+	ubuf->addr = NULL;
+	ubuf->size = 0;
+
 	do {
 		if (realloc_useful_buf(&creds_useful_buf)) {
 			free(creds_useful_buf.ptr);
@@ -70,8 +74,13 @@
 		QCBOREncode_AddInt64ToMapN(&e_ctx, attr_system_time,
 					   get_time_in_ms());
 		QCBOREncode_CloseMap(&e_ctx);
-	} while (QCBOREncode_Finish(&e_ctx, &enc) ==
-		 QCBOR_ERR_BUFFER_TOO_SMALL);
+		error = QCBOREncode_Finish(&e_ctx, &enc);
+	} while (error == QCBOR_ERR_BUFFER_TOO_SMALL);
+
+	if (error != QCBOR_SUCCESS || !enc.ptr || !enc.len) {
+		free(creds_useful_buf.ptr);
+		return -1;
+	}
 
 	ubuf->addr = (void *)enc.ptr;
 	ubuf->size = enc.len;
