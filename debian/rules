#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
include /usr/share/dpkg/buildflags.mk
%:
	dh $@
override_dh_auto_configure:
override_dh_auto_test:
	# No upstream execution is authorized by source preparation.
override_dh_auto_clean:
	rm -rf build
override_dh_auto_install:
# Device-event activation remains in the shipped units and udev rules.
# Do not start hardware services during package configuration.
override_dh_installsystemd:
	dh_installsystemd --no-start
override_dh_auto_build:
	mkdir -p build
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -std=c++20 -Wall -Wextra -Werror src/bluetooth-address.cpp $(LDFLAGS) -o build/uke-bluetooth-address

override_dh_installudev:
	dh_installudev --priority=70
