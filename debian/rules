#!/usr/bin/make -f
%:
	dh $@
override_dh_auto_configure:
override_dh_auto_build:
override_dh_auto_clean:
override_dh_auto_test:
	printf '%s  %s\n' f319e71d60ed19d539296665fa06cc07fbcf93bf82f773c787bed65289129e7b fs19xx.fsm | sha256sum -c -
override_dh_auto_install:
	install -Dm644 fs19xx.fsm debian/uke-speaker-firmware/usr/lib/firmware/qcom/uke/audio/fs19xx.fsm
	install -d debian/uke-speaker-firmware/usr/share/doc/uke-speaker-firmware
	install -m644 provenance.json odm-NOTICE.xml.gz LICENSE.Apache-2.0 README.md debian/uke-speaker-firmware/usr/share/doc/uke-speaker-firmware/
override_dh_strip_nondeterminism:
override_dh_compress:
	dh_compress -Xodm-NOTICE.xml.gz -Xprovenance.json -XLICENSE.Apache-2.0
