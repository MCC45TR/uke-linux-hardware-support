From: MCC45TR <75160848+MCC45TR@users.noreply.github.com>
Subject: [PATCH] content: resolve Iris codec nodes before the Linux ARM GPU sandbox

The VA backend stores a discovered device path and opens a fresh V4L2
session for each context. Resolve the kernel qcom-iris driver and decoder/
encoder names through sysfs before BPF; grant only the enabled direction's
current node. Never grant every video node or depend on video1/video2 numbers.

Source identities: Linux7.3.0-15/source770b877 iris_probe.c; backend
6d03c3f decoder.cpp/encoder.cpp. Host fixture only; real sandboxed V4L2
sessions remain unverified, especially after the separate High/B2 fatal.

--- a/content/common/gpu_pre_sandbox_hook_linux.cc
+++ b/content/common/gpu_pre_sandbox_hook_linux.cc
@@ -18,6 +18,7 @@
 #include "base/base_paths.h"
 #include "base/files/file_enumerator.h"
 #include "base/files/file_path.h"
+#include "base/files/file_util.h"
 #include "base/files/scoped_file.h"
 #include "base/functional/bind.h"
 #include "base/logging.h"
@@ -250,6 +251,30 @@
   }
 }
 
+void AddIrisGpuPermissions(
+    std::vector<BrokerFilePermission>* permissions,
+    const sandbox::policy::SandboxSeccompBPF::Options& options) {
+  // Resolve kernel-owned identities; video0 may be a camera or touch device.
+  base::FileEnumerator nodes(base::FilePath("/sys/class/video4linux"), false,
+                             base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath node = nodes.Next(); !node.empty(); node = nodes.Next()) {
+    base::FilePath driver;
+    std::string name;
+    if (!base::ReadSymbolicLink(node.Append("device/driver"), &driver) ||
+        driver.BaseName().value() != "qcom-iris" ||
+        !base::ReadFileToStringWithMaxSize(node.Append("name"), &name, 64)) {
+      continue;
+    }
+    if ((name == "qcom-iris-decoder\n" &&
+         options.accelerated_video_decode_enabled) ||
+        (name == "qcom-iris-encoder\n" &&
+         options.accelerated_video_encode_enabled)) {
+      permissions->push_back(BrokerFilePermission::ReadWrite(
+          base::FilePath("/dev").Append(node.BaseName()).value()));
+    }
+  }
+}
+
 void AddArmMesaGpuPermissions(std::vector<BrokerFilePermission>* permissions) {
   AddDrmGpuPermissions(permissions);
   // GLVND discovers Mesa after the early sandbox has started.
@@ -683,8 +708,10 @@
   }
 
   AddStandardGpuPermissions(&permissions);
-  if (IsArchitectureArm())
+  if (IsArchitectureArm()) {
     AddArmMesaGpuPermissions(&permissions);
+    AddIrisGpuPermissions(&permissions, options);
+  }
   return permissions;
 }
 
