# Linux exports Wireless as a standard external power-supply type.
# Online state still comes from sysfs; unknown types retain their diagnostics.
diff --git a/src/linux/up-device-supply.c b/src/linux/up-device-supply.c
--- a/src/linux/up-device-supply.c
+++ b/src/linux/up-device-supply.c
@@ -570,4 +570,5 @@ up_device_supply_guess_type (GUdevDevice *native,
-	if (g_ascii_strcasecmp (device_type, "mains") == 0) {
-		type = UP_DEVICE_KIND_LINE_POWER;
-		goto out;
-	}
+	if (g_ascii_strcasecmp (device_type, "mains") == 0 ||
+	    g_ascii_strcasecmp (device_type, "wireless") == 0) {
+		type = UP_DEVICE_KIND_LINE_POWER;
+		goto out;
+	}
