From: Senemos Maintainers <75160848+MCC45TR@users.noreply.github.com>
Subject: [PATCH] Keep reported battery health separate from inferred energy capacity

Base: UPower ecfd2e166b6213bbdaa4e7c952ebb9a6c1405337
Source license: GPL-2.0-or-later; original upstream attribution is retained.
Source candidate only. No patch application, build, host test or installed
daemon validation was executed. Uke battery controls remain disabled.

--- a/src/up-device-battery.c
+++ b/src/up-device-battery.c
@@ -231,7 +231,8 @@
 static gdouble
 up_device_battery_calc_capacity (gdouble energy_full, gdouble energy_design)
 {
-	if (energy_design > 0.0)
+	if (isfinite (energy_full) && energy_full >= 0.01 &&
+	    isfinite (energy_design) && energy_design > 0.0)
 		return MIN (energy_full / energy_design * 100.0, 100.0);
 	return 0.0;
 }
@@ -320,7 +321,7 @@
 			priv->energy_full = values->energy.cur;
 			g_object_set (self,
 				      /* How healthy the battery is (clamp to 100% if it can hold more charge than expected) */
-				      "capacity", up_device_battery_calc_capacity (priv->energy_full, priv->energy_design),
+				      "capacity", up_device_battery_calc_capacity (priv->energy_full_reported, priv->energy_design),
 				      "energy-full", priv->energy_full,
 				      NULL);
 		}
@@ -531,6 +532,7 @@
 
 	if (info->present) {
 		gdouble energy_full;
+		gdouble energy_full_reported;
 		gdouble energy_design;
 		gint charge_cycles;
 
@@ -575,20 +577,22 @@
 			energy_design = info->energy.design;
 		}
 
+		/* A design fallback supports energy estimates, not measured health. */
+		energy_full_reported = energy_full;
 		if (energy_full < 0.01)
 			energy_full = energy_design;
 
 		/* Force -1 for unknown value (where 0 is also an unknown value) */
 		charge_cycles = info->charge_cycles > 0 ? info->charge_cycles : -1;
 
-		if (energy_full != priv->energy_full_reported || energy_design != priv->energy_design) {
+		if (energy_full_reported != priv->energy_full_reported || energy_design != priv->energy_design) {
 			priv->energy_full = energy_full;
-			priv->energy_full_reported = energy_full;
+			priv->energy_full_reported = energy_full_reported;
 			priv->energy_design = energy_design;
 
 			g_object_set (self,
 			              /* How healthy the battery is (clamp to 100% if it can hold more charge than expected) */
-			              "capacity", up_device_battery_calc_capacity (priv->energy_full, priv->energy_design),
+			              "capacity", up_device_battery_calc_capacity (priv->energy_full_reported, priv->energy_design),
 			              "energy-full", priv->energy_full,
 			              "energy-full-design", priv->energy_design,
 			              NULL);
