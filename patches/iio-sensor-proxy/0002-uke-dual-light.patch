Subject: [PATCH] Combine the two Uke ambient-light channels in the SSC backend

Upstream: iio-sensor-proxy 3.9. The exact-board udev property opts Uke into
front/rear acquisition. Wait for both valid measurements, then use the brighter
calibrated lux channel as in the OEM main/assist selection rule. Keep original
KDE brightness policy and filtering. Other devices retain the existing backend.

--- a/src/drv-ssc-light.c
+++ b/src/drv-ssc-light.c
@@ -17,10 +17,14 @@
 #include <gio/gio.h>
 #include <libssc-sensor.h>
 #include <libssc-sensor-light.h>
+#include "dual-light.h"
 
 typedef struct DrvData {
 	SSCSensorLight *sensor;
 	gulong measurement_id;
+	SSCSensorLight *rear;
+	gulong rear_measurement_id;
+	struct UkeDualLight combined;
 } DrvData;
 
 static gboolean
@@ -39,6 +43,11 @@
 
 	if (!ssc_sensor_light_close_sync (sensor, NULL, NULL))
 		return FALSE;
+	if (g_udev_device_get_property_as_boolean (device, "UKE_SSC_DUAL_LIGHT")) {
+		g_autoptr(SSCSensorLight) rear = ssc_sensor_light_new_for_type_sync ("ambient_light_back", NULL, NULL);
+		if (!rear || !ssc_sensor_light_close_sync (rear, NULL, NULL))
+			return FALSE;
+	}
 
 	g_debug ("Found SSC light at %s", g_udev_device_get_sysfs_path (device));
 	return TRUE;
@@ -49,6 +58,14 @@
 {
 	SensorDevice *sensor_device = user_data;
 	LightReadings readings;
+	DrvData *drv_data = sensor_device->priv;
+	float combined;
+
+	if (drv_data->rear) {
+		if (!uke_dual_light_update (&drv_data->combined, sensor == drv_data->rear, intensity, &combined))
+			return;
+		intensity = combined;
+	}
 
 	readings.level = intensity;
 	readings.uses_lux = TRUE;
@@ -67,6 +84,16 @@
 
 	drv_data = (DrvData *) sensor_device->priv;
 	drv_data->sensor = ssc_sensor_light_new_sync (NULL, &error);
+	if (drv_data->sensor && g_udev_device_get_property_as_boolean (device, "UKE_SSC_DUAL_LIGHT")) {
+		drv_data->rear = ssc_sensor_light_new_for_type_sync ("ambient_light_back", NULL, &error);
+		if (!drv_data->rear) {
+			g_warning ("Creating rear SSC light sensor failed: %s", error ? error->message : "UNKNOWN");
+			g_clear_object (&drv_data->sensor);
+			g_free (drv_data);
+			g_free (sensor_device);
+			return NULL;
+		}
+	}
 	if (!drv_data->sensor)
 		g_warning ("Creating SSC light sensor failed: %s", error->message);
 	else
@@ -85,20 +112,43 @@
 	if (state) {
 		if (drv_data->measurement_id)
 			return;
+		memset (&drv_data->combined, 0, sizeof (drv_data->combined));
 		/* Start listening for measurements */
 		drv_data->measurement_id = g_signal_connect (drv_data->sensor,
 					                     "measurement",
 							     G_CALLBACK (measurement_cb),
 							     sensor_device);
+		if (drv_data->rear)
+			drv_data->rear_measurement_id = g_signal_connect (drv_data->rear, "measurement", G_CALLBACK (measurement_cb), sensor_device);
 		/* Enable sensor */
-		if (!ssc_sensor_light_open_sync (drv_data->sensor, NULL, &error))
+		if (!ssc_sensor_light_open_sync (drv_data->sensor, NULL, &error)) {
 			g_warning ("Opening SSC light sensor failed: %s", error->message);
+			g_clear_signal_handler (&drv_data->measurement_id, drv_data->sensor);
+			if (drv_data->rear)
+				g_clear_signal_handler (&drv_data->rear_measurement_id, drv_data->rear);
+			g_clear_error (&error);
+			ssc_sensor_light_close_sync (drv_data->sensor, NULL, &error);
+		} else if (drv_data->rear && !ssc_sensor_light_open_sync (drv_data->rear, NULL, &error)) {
+			g_warning ("Opening rear SSC light sensor failed: %s", error ? error->message : "UNKNOWN");
+			g_clear_signal_handler (&drv_data->measurement_id, drv_data->sensor);
+			g_clear_signal_handler (&drv_data->rear_measurement_id, drv_data->rear);
+			g_clear_error (&error);
+			ssc_sensor_light_close_sync (drv_data->rear, NULL, &error);
+			g_clear_error (&error);
+			ssc_sensor_light_close_sync (drv_data->sensor, NULL, &error);
+		}
 	} else {
 		if (!drv_data->measurement_id)
 			return;
 
 		/* Stop listening for measurements */
 		g_clear_signal_handler (&drv_data->measurement_id, drv_data->sensor);
+		if (drv_data->rear) {
+			g_clear_signal_handler (&drv_data->rear_measurement_id, drv_data->rear);
+			if (!ssc_sensor_light_close_sync (drv_data->rear, NULL, &error))
+				g_warning ("Closing rear SSC light sensor failed: %s", error ? error->message : "UNKNOWN");
+			g_clear_error (&error);
+		}
 
 		/* Disable sensor */
 		if (!ssc_sensor_light_close_sync (drv_data->sensor, NULL, &error))
@@ -113,6 +163,7 @@
 	DrvData *drv_data = (DrvData *) sensor_device->priv;
 
 	g_clear_object (&drv_data->sensor);
+	g_clear_object (&drv_data->rear);
 	g_clear_pointer (&sensor_device->priv, g_free);
 	g_free (sensor_device);
 }
