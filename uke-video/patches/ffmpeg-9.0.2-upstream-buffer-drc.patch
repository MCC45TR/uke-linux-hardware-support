+/**
+ * Wait until a capture buffer is queued in the driver, or none can be.
+ * While the user holds the others the decoder may still have frames to
+ * return, and does so once one of them is released.
+ * returns 1 if a buffer is queued, 0 if none is or will be
+ */
+static int v4l2_wait_capture_buffer(V4L2Context *ctx)
+{
+    V4L2m2mContext *s = ctx_to_m2mctx(ctx);
+    int i, queued = 0;
+
+    /* capture buffer initialization happens during decode hence
+     * detection happens at runtime
+     */
+    if (!ctx->buffers)
+        return 0;
+
+    ff_mutex_lock(&s->buffer_lock);
+    for (;;) {
+        for (i = 0; i < ctx->num_buffers; i++) {
+            if (ctx->buffers[i].status == V4L2BUF_IN_DRIVER) {
+                queued = 1;
+                break;
+            }
+        }
+        if (queued || !atomic_load(&s->refcount))
+            break;
+        ff_cond_wait(&s->buffer_cond, &s->buffer_lock);
+    }
+    ff_mutex_unlock(&s->buffer_lock);
+
+    return queued;
+}
