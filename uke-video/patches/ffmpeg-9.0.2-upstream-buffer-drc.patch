 /**
+ * reinitialize capture for a new format
+ * returns 1 if reinit was successful, negative if it failed
+ */
+static int v4l2_change_capture_format(V4L2m2mContext *s, struct v4l2_format *cap_fmt)
+{
+    int ret = 0;
+
+    s->capture.format_change = 0;
+    s->capture.height = v4l2_get_height(cap_fmt);
+    s->capture.width = v4l2_get_width(cap_fmt);
+    s->capture.sample_aspect_ratio = v4l2_get_sar(&s->capture);
+
+    ff_mutex_lock(&s->buffer_lock);
+    s->reinit = 1;
+    ff_mutex_unlock(&s->buffer_lock);
+
+    if (s->avctx)
+        ret = ff_set_dimensions(s->avctx, s->capture.width, s->capture.height);
+    if (ret < 0)
+        av_log(logger(&s->capture), AV_LOG_WARNING, "update avcodec height and width\n");
+
+    ret = ff_v4l2_m2m_codec_reinit(s);
+    if (ret) {
+        av_log(logger(&s->capture), AV_LOG_ERROR, "v4l2_m2m_codec_reinit\n");
+        return AVERROR(EINVAL);
+    }
+
+    /* reinit executed */
+    return 1;
+}
