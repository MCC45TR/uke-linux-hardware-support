     // The sequence crop determines the visible dimensions sent to Iris.
     if (!s.hevc) {
@@ -609,14 +610,13 @@ Encoder::Encoder(const std::string &device, unsigned width, unsigned height, VAP
             coded_width -= seq.frame_crop_right_offset * 2;
