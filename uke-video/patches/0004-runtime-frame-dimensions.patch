     validate(s, p, profile, width, height);
     auto impl = std::make_unique<Impl>(
@@ -665,6 +665,8 @@ Encoder::Encoder(const std::string &device, unsigned width, unsigned height, VAP
     crop.r.width = width;
     crop.r.height = height;
     checked(e.fd, VIDIOC_S_SELECTION, &crop, "encoder S_SELECTION");
+    check(crop.r.width == width && crop.r.height == height && !crop.r.left && !crop.r.top,
