                                        const std::shared_ptr<Surface> &input,
@@ -278,7 +286,7 @@ struct Driver {
     std::recursive_mutex mutex;
     std::string device;
     std::string encoder_device;
-    std::vector<VAProfile> decoder_profiles, encoder_profiles;
