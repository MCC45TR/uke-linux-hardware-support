From: MCC45TR <75160848+MCC45TR@users.noreply.github.com>
Subject: [PATCH] Use codec-specific V4L2 dimensions for VA queries and encode

Retain frame-size bounds with each runtime profile. Use the same bounds in
VA attributes, surface queries and context/visible encode validation instead
of fixed 128/3840/2160/8192 limits. Keep decoder geometry hints distinct from
the actual stream and reject a substituted encoder crop. Pixel/macroblock
rate, queue admission and physical mode acceptance remain kernel/test gates.

---
diff --git a/src/backend.cpp b/src/backend.cpp
index 67b4707..eea94b6 100644
--- a/src/backend.cpp
+++ b/src/backend.cpp
@@ -87,18 +87,19 @@ template <class F> VAStatus guard(VADriverContextP ctx, F f) noexcept {
         return guard(ctx, [&](Driver &d) -> VAStatus { __VA_ARGS__ });                             \
     }
 static bool decode_supported(const Driver &d, VAProfile p) {
-    return std::find(d.decoder_profiles.begin(), d.decoder_profiles.end(), p) !=
-           d.decoder_profiles.end();
+    return d.decoder_profiles.count(p);
 }
 static bool supported(const Driver &d, VAProfile p) {
-    return decode_supported(d, p) ||
-           std::find(d.encoder_profiles.begin(), d.encoder_profiles.end(), p) !=
-           d.encoder_profiles.end();
+    return decode_supported(d, p) || d.encoder_profiles.count(p);
 }
 static bool encode_supported(const Driver &d, VAProfile p, VAEntrypoint e) {
-    return e == VAEntrypointEncSlice &&
-           std::find(d.encoder_profiles.begin(), d.encoder_profiles.end(), p) !=
-           d.encoder_profiles.end();
+    return e == VAEntrypointEncSlice && d.encoder_profiles.count(p);
+}
+static const FrameSize &profile_limits(const Driver &d, VAProfile p, VAEntrypoint e) {
+    const auto &profiles = e == VAEntrypointEncSlice ? d.encoder_profiles : d.decoder_profiles;
+    auto it = profiles.find(p);
+    check(it != profiles.end(), "unsupported profile", VA_STATUS_ERROR_UNSUPPORTED_PROFILE);
+    return it->second;
 }
 static unsigned encode_attribute(VAConfigAttribType type, VAProfile profile) {
     switch (type) {
@@ -142,10 +143,6 @@ static unsigned encode_attribute(VAConfigAttribType type, VAProfile profile) {
         return 1;
     case VAConfigAttribPredictionDirection:
         return VA_PREDICTION_DIRECTION_PREVIOUS;
-    case VAConfigAttribMaxPictureWidth:
-        return 3840;
-    case VAConfigAttribMaxPictureHeight:
-        return 2160;
     default:
         return VA_ATTRIB_NOT_SUPPORTED;
     }
@@ -255,9 +252,9 @@ static std::shared_ptr<Memory> allocate_undecoded_surface(VADriverContextP ctx,
 API(query_profiles, (VADriverContextP ctx, VAProfile *out, int *count), (void)d;
     check(out && count, "null profiles", VA_STATUS_ERROR_INVALID_PARAMETER);
     *count = 0;
-    for (auto p : d.decoder_profiles) out[(*count)++] = p;
-    for (auto p : d.encoder_profiles)
-        if (!decode_supported(d, p)) out[(*count)++] = p;
+    for (const auto &p : d.decoder_profiles) out[(*count)++] = p.first;
+    for (const auto &p : d.encoder_profiles)
+        if (!decode_supported(d, p.first)) out[(*count)++] = p.first;
     if (vpp_supported(VAProfileNone, VAEntrypointVideoProc)) out[(*count)++] = VAProfileNone;
     return VA_STATUS_SUCCESS;)
 API(query_entrypoints, (VADriverContextP ctx, VAProfile profile, VAEntrypoint *out, int *count),
@@ -288,6 +285,13 @@ API(
                                  : VA_ATTRIB_NOT_SUPPORTED;
             continue;
         }
+        if (attrs[i].type == VAConfigAttribMaxPictureWidth ||
+            attrs[i].type == VAConfigAttribMaxPictureHeight) {
+            const auto &limits = profile_limits(d, profile, entry);
+            attrs[i].value = attrs[i].type == VAConfigAttribMaxPictureWidth
+                                 ? limits.max_width : limits.max_height;
+            continue;
+        }
         if (entry == VAEntrypointEncSlice) {
             attrs[i].value = encode_attribute(attrs[i].type, profile);
             continue;
@@ -299,10 +303,6 @@ API(
         case VAConfigAttribDecSliceMode:
             attrs[i].value = VA_DEC_SLICE_MODE_NORMAL;
             break;
-        case VAConfigAttribMaxPictureWidth:
-        case VAConfigAttribMaxPictureHeight:
-            attrs[i].value = 8192;
-            break;
         default:
             attrs[i].value = VA_ATTRIB_NOT_SUPPORTED;
         }
@@ -369,9 +369,12 @@ API(
     if (config.entrypoint == VAEntrypointVideoProc) {
         values[1] = 16;
         values[2] = 2;
-    } if (config.entrypoint == VAEntrypointEncSlice) {
-        values[3] = 3840;
-        values[4] = 2160;
+    } else {
+        const auto &limits = profile_limits(d, profile, config.entrypoint);
+        values[1] = limits.min_width;
+        values[2] = limits.min_height;
+        values[3] = limits.max_width;
+        values[4] = limits.max_height;
     } for (unsigned i = 0; i < 6; ++i) {
         a[i].type = types[i];
         a[i].flags = VA_SURFACE_ATTRIB_GETTABLE;
@@ -558,14 +561,24 @@ API(create_context,
     (void)flags;
     auto config = lookup(d.configs, id, VA_STATUS_ERROR_INVALID_CONFIG);
     bool processing = config.entrypoint == VAEntrypointVideoProc;
-    check(((processing && w >= 0 && h >= 0) || (w >= 128 && h >= 128)) && w <= 8192 && h <= 8192 &&
+    check(((processing && w >= 0 && h >= 0) || (w > 0 && h > 0)) && w <= 8192 && h <= 8192 &&
               result,
           "invalid context dimensions", VA_STATUS_ERROR_RESOLUTION_NOT_SUPPORTED);
     auto c = std::make_shared<Context>(); c->profile = config.profile;
     c->entrypoint = config.entrypoint; c->encode_settings.rate_control = config.rate_control;
-    c->encode_settings.hevc = is_hevc(c->profile); if (c->entrypoint == VAEntrypointEncSlice)
-        check(w <= 3840 && h <= 2160 && !(w & 1) && !(h & 1), "unsupported encoder dimensions",
-              VA_STATUS_ERROR_RESOLUTION_NOT_SUPPORTED);
+    c->encode_settings.hevc = is_hevc(c->profile);
+    if (!processing) {
+        const auto &limits = profile_limits(d, c->profile, c->entrypoint);
+        // Decode dimensions are hints; coded geometry is established by the stream.
+        if (c->entrypoint == VAEntrypointVLD)
+            check(unsigned(w) <= limits.max_width && unsigned(h) <= limits.max_height,
+                  "unsupported decoder dimensions", VA_STATUS_ERROR_RESOLUTION_NOT_SUPPORTED);
+        else
+            check(unsigned(w) >= limits.min_width && unsigned(h) >= limits.min_height &&
+                      unsigned(w) <= ((limits.max_width + 15) & ~15u) &&
+                      unsigned(h) <= ((limits.max_height + 15) & ~15u) && !(w & 1) && !(h & 1),
+                  "unsupported encoder dimensions", VA_STATUS_ERROR_RESOLUTION_NOT_SUPPORTED);
+    }
     for (int i = 0; i < count; ++i) surface(d, targets[i]); c->width = w; c->height = h;
     c->internal_profile = c->profile; c->decode_surfaces = std::max(0, count);
     if (processing) c->vpp = std::make_unique<Vpp>(); *result = d.next_id++;
@@ -776,7 +789,8 @@ API(
                 c->encode_settings.hevc ? std::min(c->width, target->width) : c->width,
                 c->encode_settings.hevc ? std::min(c->height, target->height) : c->height,
                 c->profile, c->encode_settings, c->encode_picture,
-                static_cast<drm_state *>(ctx->drm_state)->fd);
+                static_cast<drm_state *>(ctx->drm_state)->fd,
+                profile_limits(d, c->profile, c->entrypoint));
         }
         auto task = c->encoder->encode(c->encode_settings, c->encode_picture, target, coded);
         task->encoder = c->encoder;
diff --git a/src/encoder.cpp b/src/encoder.cpp
