+std::map<VAProfile, FrameSize> probe_profiles(const std::string &path, bool encoder) {
+    std::map<VAProfile, FrameSize> result;
     if (path.empty()) return result;
     int fd = open(path.c_str(), O_RDWR | O_NONBLOCK | O_CLOEXEC);
     check(fd >= 0, "open Iris capability probe");
@@ -78,7 +78,19 @@ std::vector<VAProfile> probe_profiles(const std::string &path, bool encoder) {
             menu.index = profile.menu;
             if (query(fd, VIDIOC_QUERYMENU, &menu) < 0 ||
                 !format_available(fd, raw, profile.raw)) continue;
-            result.push_back(profile.va);
+            v4l2_frmsizeenum size{};
+            size.pixel_format = profile.codec;
+            if (query(fd, VIDIOC_ENUM_FRAMESIZES, &size) < 0 ||
+                (size.type != V4L2_FRMSIZE_TYPE_STEPWISE &&
+                 size.type != V4L2_FRMSIZE_TYPE_CONTINUOUS) ||
+                !size.stepwise.step_width || !size.stepwise.step_height) continue;
+            FrameSize limits{size.stepwise.min_width, size.stepwise.min_height,
+                             std::min(8192u, size.stepwise.max_width),
+                             std::min(8192u, size.stepwise.max_height)};
+            if (!limits.min_width || !limits.min_height ||
+                limits.max_width < limits.min_width || limits.max_height < limits.min_height)
+                continue;
+            result.emplace(profile.va, limits);
         }
     } catch (...) {
         close(fd);
