     if (s.hevc) {
         e.control(V4L2_CID_MPEG_VIDEO_HEVC_PROFILE,
                   profile == VAProfileHEVCMain10 ? V4L2_MPEG_VIDEO_HEVC_PROFILE_MAIN_10
diff --git a/src/internal.hpp b/src/internal.hpp
index e12af2e..96116ee 100644
--- a/src/internal.hpp
+++ b/src/internal.hpp
@@ -71,6 +71,13 @@ class SurfaceCopier {
     void copy(const std::shared_ptr<Memory> &destination, const std::shared_ptr<Memory> &source,
               unsigned width, unsigned height);
 };
+struct FrameSize {
+    unsigned min_width, min_height, max_width, max_height;
+    bool contains(unsigned width, unsigned height) const {
+        return width >= min_width && height >= min_height &&
+               width <= max_width && height <= max_height;
+    }
+};
 class Encoder;
 struct EncodeTask {
     std::weak_ptr<Encoder> encoder;
@@ -221,7 +228,8 @@ class Encoder {
 
