--- a/libavcodec/v4l2_context.c
+++ b/libavcodec/v4l2_context.c
@@ -819,7 +819,100 @@
 
 int ff_v4l2_context_set_format(V4L2Context* ctx)
 {
-    return ioctl(ctx_to_m2mctx(ctx)->fd, VIDIOC_S_FMT, &ctx->format);
+    V4L2m2mContext *s = ctx_to_m2mctx(ctx);
+    AVCodecContext *avctx = s->avctx;
+    struct v4l2_format wanted;
+    uint32_t cs = 0, xf = 0, yc = 0, qt = 0;
+    int color = 0, range = 0, ret;
+
+    if (V4L2_TYPE_IS_OUTPUT(ctx->type) &&
+        ctx->av_codec_id == AV_CODEC_ID_RAWVIDEO &&
+        avctx && av_codec_is_encoder(avctx->codec)) {
+        color = avctx->color_primaries != AVCOL_PRI_UNSPECIFIED ||
+                avctx->color_trc != AVCOL_TRC_UNSPECIFIED ||
+                avctx->colorspace != AVCOL_SPC_UNSPECIFIED;
+        range = avctx->color_range != AVCOL_RANGE_UNSPECIFIED;
+        if (color) {
+            /* Do not replace an unrepresentable explicit CICP value with a default. */
+            switch (avctx->color_primaries) {
+            case AVCOL_PRI_BT709:     cs = V4L2_COLORSPACE_REC709; break;
+            case AVCOL_PRI_BT470M:    cs = V4L2_COLORSPACE_470_SYSTEM_M; break;
+            case AVCOL_PRI_BT470BG:   cs = V4L2_COLORSPACE_470_SYSTEM_BG; break;
+            case AVCOL_PRI_SMPTE170M: cs = V4L2_COLORSPACE_SMPTE170M; break;
+            case AVCOL_PRI_SMPTE240M: cs = V4L2_COLORSPACE_SMPTE240M; break;
+            case AVCOL_PRI_BT2020:    cs = V4L2_COLORSPACE_BT2020; break;
+            case AVCOL_PRI_SMPTE431:  cs = V4L2_COLORSPACE_DCI_P3; break;
+            default: goto color_error;
+            }
+            switch (avctx->color_trc) {
+            case AVCOL_TRC_BT709:         xf = V4L2_XFER_FUNC_709; break;
+            case AVCOL_TRC_SMPTE240M:     xf = V4L2_XFER_FUNC_SMPTE240M; break;
+            case AVCOL_TRC_LINEAR:        xf = V4L2_XFER_FUNC_NONE; break;
+            case AVCOL_TRC_IEC61966_2_1:   xf = V4L2_XFER_FUNC_SRGB; break;
+            case AVCOL_TRC_SMPTE2084:     xf = V4L2_XFER_FUNC_SMPTE2084; break;
+            case AVCOL_TRC_SMPTE428:      xf = V4L2_XFER_FUNC_DCI_P3; break;
+            default: goto color_error;
+            }
+            switch (avctx->colorspace) {
+            case AVCOL_SPC_BT709:      yc = V4L2_YCBCR_ENC_709; break;
+            case AVCOL_SPC_SMPTE170M:  yc = V4L2_YCBCR_ENC_601; break;
+            case AVCOL_SPC_SMPTE240M:  yc = V4L2_YCBCR_ENC_SMPTE240M; break;
+            case AVCOL_SPC_BT2020_NCL: yc = V4L2_YCBCR_ENC_BT2020; break;
+            case AVCOL_SPC_BT2020_CL:  yc = V4L2_YCBCR_ENC_BT2020_CONST_LUM; break;
+            default: goto color_error;
+            }
+        }
+        if (range) {
+            switch (avctx->color_range) {
+            case AVCOL_RANGE_MPEG: qt = V4L2_QUANTIZATION_LIM_RANGE; break;
+            case AVCOL_RANGE_JPEG: qt = V4L2_QUANTIZATION_FULL_RANGE; break;
+            default: goto color_error;
+            }
+        }
+        if (V4L2_TYPE_IS_MULTIPLANAR(ctx->type)) {
+            if (color) {
+                ctx->format.fmt.pix_mp.colorspace = cs;
+                ctx->format.fmt.pix_mp.xfer_func = xf;
+                ctx->format.fmt.pix_mp.ycbcr_enc = yc;
+            }
+            if (range)
+                ctx->format.fmt.pix_mp.quantization = qt;
+        } else {
+            if (color || range)
+                ctx->format.fmt.pix.priv = V4L2_PIX_FMT_PRIV_MAGIC;
+            if (color) {
+                ctx->format.fmt.pix.colorspace = cs;
+                ctx->format.fmt.pix.xfer_func = xf;
+                ctx->format.fmt.pix.ycbcr_enc = yc;
+            }
+            if (range)
+                ctx->format.fmt.pix.quantization = qt;
+        }
+    }
+
+    wanted = ctx->format;
+    ret = ioctl(s->fd, VIDIOC_S_FMT, &ctx->format);
+    if (ret)
+        return ret;
+
+    if (V4L2_TYPE_IS_MULTIPLANAR(ctx->type)) {
+        if ((color && (wanted.fmt.pix_mp.colorspace != ctx->format.fmt.pix_mp.colorspace ||
+                       wanted.fmt.pix_mp.xfer_func != ctx->format.fmt.pix_mp.xfer_func ||
+                       wanted.fmt.pix_mp.ycbcr_enc != ctx->format.fmt.pix_mp.ycbcr_enc)) ||
+            (range && wanted.fmt.pix_mp.quantization != ctx->format.fmt.pix_mp.quantization))
+            goto color_error;
+    } else {
+        if ((color && (wanted.fmt.pix.colorspace != ctx->format.fmt.pix.colorspace ||
+                       wanted.fmt.pix.xfer_func != ctx->format.fmt.pix.xfer_func ||
+                       wanted.fmt.pix.ycbcr_enc != ctx->format.fmt.pix.ycbcr_enc)) ||
+            (range && wanted.fmt.pix.quantization != ctx->format.fmt.pix.quantization))
+            goto color_error;
+    }
+    return 0;
+
+color_error:
+    av_log(avctx, AV_LOG_ERROR, "V4L2 encoder color tuple is incomplete, unrepresentable or changed by the driver\n");
+    return AVERROR(EINVAL);
 }
 
 void ff_v4l2_context_release(V4L2Context* ctx)
