+int ff_v4l2_context_wait_source_change(V4L2Context *ctx, int timeout)
+{
+    V4L2m2mContext *s = ctx_to_m2mctx(ctx);
+    struct pollfd pfd = {
+        .fd = s->fd,
+        .events = POLLPRI | (s->draining ? 0 : POLLOUT | POLLWRNORM),
+    };
+    int ret;
+
+    do {
+        ret = poll(&pfd, 1, timeout);
+    } while (ret < 0 && errno == EINTR);
+    if (ret < 0)
+        return AVERROR(errno);
+    if (!ret)
+        return AVERROR(EAGAIN);
+    if (pfd.revents & POLLPRI) {
+        ret = v4l2_handle_event(ctx);
+        if (ret < 0)
+            return ret;
+        if (ctx->done)
+            return AVERROR_EOF;
+        if (!s->initial_source_change)
+            return 0;
+    }
+    if (pfd.revents & (POLLERR | POLLHUP | POLLNVAL))
+        return AVERROR(EIO);
+    return AVERROR(EAGAIN);
 }
 
