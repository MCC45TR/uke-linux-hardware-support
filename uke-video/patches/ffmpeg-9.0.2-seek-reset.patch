Subject: [PATCH] avcodec/v4l2_m2m: retire decoder generations on flush

Base: FFmpeg n9.0.2 after preserve-start-errors, upstream-buffer-drc and
initial-source-sequence. Keep held buffers alive in their retired generation,
prevent late requeue, release pending packets and detach borrowed log metadata.
Open a fresh driver context lazily and preserve stop/reopen errors.
License: LGPL-2.1-or-later, matching the modified upstream files.

This remains a source/host candidate. Actual same-context seek, decoded frames,
driver limits and device lifecycle require independent Uke qualification.

--- a/libavcodec/v4l2_m2m.h
+++ b/libavcodec/v4l2_m2m.h
@@ -77,6 +77,8 @@
 
     /* reference back to V4L2m2mPriv */
     void *priv;
+    /* Protected by buffer_lock; retired buffers must never be requeued. */
+    int closing;
 } V4L2m2mContext;
 
 typedef struct V4L2m2mPriv {
@@ -86,6 +88,7 @@
 
     int num_output_buffers;
     int num_capture_buffers;
+    int reset_error;
 } V4L2m2mPriv;
 
 /**
@@ -114,7 +117,7 @@
  *
  * @param[in] The V4L2m2mPriv instantiated by the encoder/decoder.
  *
- * @returns 0
+ * @returns 0, or the first streaming-stop error after releasing resources
  *
  */
 int ff_v4l2_m2m_codec_end(V4L2m2mPriv *priv);
--- a/libavcodec/v4l2_buffers.c
+++ b/libavcodec/v4l2_buffers.c
@@ -268,7 +268,7 @@
         } else if (s->draining && V4L2_TYPE_IS_OUTPUT(avbuf->context->type)) {
             /* no need to queue more buffers to the driver */
             avbuf->status = V4L2BUF_AVAILABLE;
-        } else if (!avbuf->context->streamon || ff_v4l2_buffer_enqueue(avbuf) < 0) {
+        } else if (s->closing || !avbuf->context->streamon || ff_v4l2_buffer_enqueue(avbuf) < 0) {
             avbuf->status = V4L2BUF_AVAILABLE;
         }
         ff_cond_broadcast(&s->buffer_cond);
--- a/libavcodec/v4l2_m2m.c
+++ b/libavcodec/v4l2_m2m.c
@@ -280,27 +280,40 @@
 av_cold int ff_v4l2_m2m_codec_end(V4L2m2mPriv *priv)
 {
     V4L2m2mContext *s = priv->context;
-    int ret;
+    int ret, error = 0;
 
     if (!s)
         return 0;
 
-    if (s->fd >= 0) {
+    ff_mutex_lock(&s->buffer_lock);
+    s->closing = 1;
+    ff_mutex_unlock(&s->buffer_lock);
+
+    if (s->fd >= 0 && s->output.streamon) {
         ret = ff_v4l2_context_set_status(&s->output, VIDIOC_STREAMOFF);
-        if (ret)
+        if (ret) {
+            error = ret;
             av_log(s->avctx, AV_LOG_ERROR, "VIDIOC_STREAMOFF %s\n", s->output.name);
+        }
+    }
 
+    if (s->fd >= 0 && s->capture.streamon) {
         ret = ff_v4l2_context_set_status(&s->capture, VIDIOC_STREAMOFF);
-        if (ret)
+        if (ret) {
+            if (!error)
+                error = ret;
             av_log(s->avctx, AV_LOG_ERROR, "VIDIOC_STREAMOFF %s\n", s->capture.name);
+        }
     }
 
     ff_v4l2_context_release(&s->output);
+    av_packet_unref(&s->buf_pkt);
 
+    s->avctx = NULL;
     s->self_ref = NULL;
     av_refstruct_unref(&priv->context);
 
-    return 0;
+    return error;
 }
 
 av_cold int ff_v4l2_m2m_codec_init(V4L2m2mPriv *priv)
--- a/libavcodec/v4l2_m2m_dec.c
+++ b/libavcodec/v4l2_m2m_dec.c
@@ -34,6 +34,8 @@
 #include "v4l2_m2m.h"
 #include "v4l2_fmt.h"
 
+static av_cold int v4l2_decode_init(AVCodecContext *avctx);
+
 static int v4l2_try_start(AVCodecContext *avctx)
 {
     V4L2m2mContext *s = ((V4L2m2mPriv*)avctx->priv_data)->context;
@@ -144,11 +146,24 @@
 
 static int v4l2_receive_frame(AVCodecContext *avctx, AVFrame *frame)
 {
-    V4L2m2mContext *s = ((V4L2m2mPriv*)avctx->priv_data)->context;
-    V4L2Context *const capture = &s->capture;
-    V4L2Context *const output = &s->output;
+    V4L2m2mPriv *priv = avctx->priv_data;
+    V4L2m2mContext *s;
+    V4L2Context *capture, *output;
     int ret;
 
+    if (priv->reset_error < 0)
+        return priv->reset_error;
+    if (!priv->context) {
+        ret = v4l2_decode_init(avctx);
+        if (ret < 0) {
+            ff_v4l2_m2m_codec_end(priv);
+            return ret;
+        }
+    }
+    s = priv->context;
+    capture = &s->capture;
+    output = &s->output;
+
 retry:
     if (!s->buf_pkt.size) {
         ret = ff_decode_get_packet(avctx, &s->buf_pkt);
@@ -252,6 +267,13 @@
     return ff_v4l2_m2m_codec_end(avctx->priv_data);
 }
 
+static void v4l2_decode_flush(AVCodecContext *avctx)
+{
+    V4L2m2mPriv *priv = avctx->priv_data;
+    if (priv->context)
+        priv->reset_error = ff_v4l2_m2m_codec_end(priv);
+}
+
 #define OFFSET(x) offsetof(V4L2m2mPriv, x)
 #define FLAGS AV_OPT_FLAG_VIDEO_PARAM | AV_OPT_FLAG_DECODING_PARAM
 
@@ -282,6 +304,7 @@
         .init           = v4l2_decode_init, \
         FF_CODEC_RECEIVE_FRAME_CB(v4l2_receive_frame), \
         .close          = v4l2_decode_close, \
+        .flush          = v4l2_decode_flush, \
         .bsfs           = bsf_name, \
         .p.capabilities = AV_CODEC_CAP_HARDWARE | AV_CODEC_CAP_DELAY | AV_CODEC_CAP_AVOID_PROBING, \
         .caps_internal  = FF_CODEC_CAP_NOT_INIT_THREADSAFE | \
