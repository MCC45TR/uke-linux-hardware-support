Subject: [PATCH] avcodec/v4l2_m2m: keep feeding queued input across readiness gaps

The caller can submit EOF while the decoder still has filtered or pending
input. Capture readiness may return EAGAIN after the last packet is queued
but before the wrapper reads filter EOF and sends STOP. Retry the input and
capture loop rather than leaking this intermediate EAGAIN to the flush caller.
Keep the nonblocking EAGAIN return when the input filter actually needs input.
After STOP, skip packet acquisition and wait for a frame, EOF or a real error.
Treat an active blocking drain's POLLERR as EIO so readiness retries do not
turn a device error into a busy loop. Preserve ordinary startup errors.

Base: FFmpeg n9.0.2 plus the reviewed Uke streaming candidate.
License: LGPL-2.1-or-later, matching the modified upstream files.

--- a/libavcodec/v4l2_m2m_dec.c
+++ b/libavcodec/v4l2_m2m_dec.c
@@ -165,6 +165,9 @@
     output = &s->output;
 
 retry:
+    if (s->draining)
+        goto dequeue;
+
     if (!s->buf_pkt.size) {
         ret = ff_decode_get_packet(avctx, &s->buf_pkt);
         if (ret < 0) {
@@ -182,9 +185,6 @@
         }
     }
 
-    if (s->draining)
-        goto dequeue;
-
     ret = ff_v4l2_context_enqueue_packet(output, &s->buf_pkt);
     if (ret < 0 && ret != AVERROR(EAGAIN))
         goto fail;
@@ -219,7 +219,10 @@
             return ret;
     }
 
-    return ff_v4l2_context_dequeue_frame(capture, frame, -1);
+    ret = ff_v4l2_context_dequeue_frame(capture, frame, -1);
+    if (ret == AVERROR(EAGAIN))
+        goto retry;
+    return ret;
 fail:
     av_packet_unref(&s->buf_pkt);
     return ret;
--- a/libavcodec/v4l2_context.c
+++ b/libavcodec/v4l2_context.c
@@ -419,6 +419,12 @@
 
     /* 0. handle errors */
     if (pfd.revents & POLLERR) {
+        if (timeout < 0 && ctx_to_m2mctx(ctx)->draining &&
+            !V4L2_TYPE_IS_OUTPUT(ctx->type) && ctx->streamon && ctx->buffers && !ctx->done) {
+            ctx->error = AVERROR(EIO);
+            ctx->done = 1;
+            return NULL;
+        }
         /* if we are trying to get free buffers but none have been queued yet,
          * or if no buffers have been allocated yet, no need to raise a warning
          */
