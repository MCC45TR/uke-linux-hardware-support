%global debug_package %{nil}
%global _build_id_links none
%global __brp_strip %{nil}
%global __brp_strip_comment_note %{nil}
%global __brp_strip_lto %{nil}
%global __brp_mangle_shebangs %{nil}

Name:           %{app_name}
Version:        %{app_version}
Release:        2.uke%{?dist}
Summary:        %{app_summary}
License:        %{app_license}
URL:            %{app_upstream}
Source0:        %{app_asset}
Source1:        %{app_license_url}
ExclusiveArch:  aarch64
BuildRequires:  binutils
BuildRequires:  cpio
BuildRequires:  rpm
AutoReqProv:    no
@APP_REQUIRES@
%if %{app_alternatives}
Requires(posttrans): /usr/sbin/alternatives
Requires(postun): /usr/sbin/alternatives
%endif

%description
%{app_summary}. This package uses the official AArch64 release payload
and the upstream runtime dependencies. Corresponding source is available
from the upstream release.

%prep
%setup -q -c -T
printf '%%s  %%s\n' '%{app_digest}' '%{SOURCE0}' | sha256sum -c --strict
printf '%%s  %%s\n' '%{app_license_digest}' '%{SOURCE1}' | sha256sum -c --strict
test "$(rpm -qp --qf '%%{NAME} %%{VERSION} %%{ARCH}' '%{SOURCE0}')" = '%{name} %{version} aarch64'
install -m0644 '%{SOURCE1}' UPSTREAM-LICENSE

%build

%install
mkdir -p '%{buildroot}'
set -o pipefail
(
    cd '%{buildroot}'
    rpm2cpio '%{SOURCE0}' | cpio -idm --quiet --no-absolute-filenames \
        '.%{app_dir}' '.%{app_dir}/*' './usr/share/*' './usr/bin/%{name}'
)
# Fedora uses the Chromium namespace sandbox for these clients.
chmod 0755 '%{buildroot}%{app_dir}/chrome-sandbox'

%check
LC_ALL=C readelf -h '%{buildroot}%{app_dir}/%{name}' | grep -Eq 'Machine: *AArch64'
test -s '%{buildroot}%{_datadir}/applications/%{name}.desktop'
test -z "$(find '%{buildroot}' -iname '*.py' -o -iname '*.pyc' -o -iname '*libpython*')"

%if %{app_alternatives}
%posttrans
/usr/sbin/alternatives --install '%{_bindir}/%{name}' '%{name}' '%{app_dir}/%{name}' 100 ||
    test -x '%{_bindir}/%{name}'

%postun
if [ "$1" -eq 0 ]; then
    /usr/sbin/alternatives --remove '%{name}' '%{app_dir}/%{name}' || :
fi
%endif

%files
%license UPSTREAM-LICENSE
%{app_dir}/
%if %{app_alternatives}
%ghost %{_bindir}/%{name}
%else
%{_bindir}/%{name}
%endif
@APP_FILES@

%changelog
* Sun Nov 22 2026 MCC45TR <75160848+MCC45TR@users.noreply.github.com> - %{version}-2.uke
- Package the official AArch64 release payload for signed COPR delivery.
